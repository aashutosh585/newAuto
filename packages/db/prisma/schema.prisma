datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum StageName {
  COLLECT
  RANK
  WRITE
  RENDER
  PUBLISH
  TRACK
}

enum EventLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum ItemStatus {
  COLLECTED
  DROPPED
  PASSED_TO_RANK
}

enum AssetType {
  CAROUSEL_IMAGE
  VIDEO
  AUDIO
  THUMBNAIL
}

enum PlatformChannel {
  TELEGRAM
  INSTAGRAM
  YOUTUBE
  X
}

enum PostStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum AccountStatus {
  HEALTHY
  EXPIRING_SOON
  EXPIRED
  ERROR
}

model Run {
  id              String       @id @default(uuid())
  slot            String       // e.g. "morning", "slot_1", "08:00"
  niche           String       // e.g. "jobs", "scholarships"
  status          RunStatus    @default(PENDING)
  idempotencyKey  String       @unique @map("idempotency_key") // e.g. "jobs-morning-2026-11-03"
  triggerSource   String       @default("cron") @map("trigger_source") // "cron", "manual", "retry"
  errorMessage    String?      @map("error_message")
  startedAt       DateTime?    @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  stages          Stage[]
  events          Event[]
  llmCalls        LlmCall[]
  items           Item[]
  rankedItems     RankedItem[]
  assets          Asset[]
  posts           Post[]

  @@index([niche, status])
  @@index([createdAt])
  @@map("runs")
}

model Stage {
  id           String      @id @default(uuid())
  runId        String      @map("run_id")
  name         StageName
  status       StageStatus @default(PENDING)
  attempt      Int         @default(1)
  itemsIn      Int         @default(0) @map("items_in")
  itemsOut     Int         @default(0) @map("items_out")
  payload      Json?
  errorMessage String?     @map("error_message")
  startedAt    DateTime?   @map("started_at")
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  run          Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  events       Event[]
  llmCalls     LlmCall[]

  @@unique([runId, name, attempt])
  @@index([runId])
  @@map("stages")
}

model Event {
  id        String     @id @default(uuid())
  runId     String?    @map("run_id")
  stageId   String?    @map("stage_id")
  level     EventLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at")

  run       Run?       @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage     Stage?     @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([stageId])
  @@index([createdAt])
  @@map("events")
}

model LlmCall {
  id               String    @id @default(uuid())
  runId            String?   @map("run_id")
  stageId          String?   @map("stage_id")
  alias            String    // "fast", "writer", "writer-local"
  model            String    // actual model name resolved by LiteLLM
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  totalTokens      Int       @default(0) @map("total_tokens")
  costUsd          Float     @default(0.0) @map("cost_usd")
  latencyMs        Int       @default(0) @map("latency_ms")
  promptPreview    String?   @map("prompt_preview") // Redacted of any keys/passwords
  responsePreview  String?   @map("response_preview")
  status           String    @default("success") // "success", "error"
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")

  run              Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  stage            Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([alias])
  @@index([createdAt])
  @@map("llm_calls")
}

model Item {
  id                String      @id @default(uuid())
  runId             String      @map("run_id")
  niche             String      // "jobs", "scholarships"
  source            String      // "jobspy", "greenhouse", "lever", "ashby", "dinomate"
  dedupeHash        String      @map("dedupe_hash")
  rawData           Json        @map("raw_data")
  externalId        String?     @map("external_id")
  externalUrl       String      @map("external_url")
  publishedAt       DateTime?   @map("published_at")
  isLive            Boolean     @default(true) @map("is_live")
  livenessCheckedAt DateTime?   @map("liveness_checked_at")
  dropReason        String?     @map("drop_reason") // ">48h old", "not fresher", "dead link"
  status            ItemStatus  @default(COLLECTED)
  createdAt         DateTime    @default(now()) @map("created_at")

  run               Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  rankedItem        RankedItem?

  @@unique([niche, dedupeHash])
  @@index([runId])
  @@index([status])
  @@map("items")
}

model RankedItem {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  itemId        String   @unique @map("item_id")
  score         Float    // 0 to 100
  reasoning     String?
  extractedData Json     @map("extracted_data") // { role, batch, skills, salary, location, ... }
  isSelected    Boolean  @default(false) @map("is_selected")
  createdAt     DateTime @default(now()) @map("created_at")

  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([isSelected])
  @@map("ranked_items")
}

model Asset {
  id            String    @id @default(uuid())
  runId         String    @map("run_id")
  type          AssetType
  path          String    // local path or public URL
  mimeType      String    @map("mime_type")
  sequenceOrder Int       @default(0) @map("sequence_order")
  metadata      Json?     // { dimensions: {width: 1080, height: 1350}, duration: 15, ... }
  createdAt     DateTime  @default(now()) @map("created_at")

  run           Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("assets")
}

model Post {
  id             String          @id @default(uuid())
  runId          String          @map("run_id")
  channel        PlatformChannel
  publisherUsed  String          @map("publisher_used") // "postmill", "direct_telegram", "direct_instagram", ...
  externalPostId String?         @map("external_post_id")
  externalPostUrl String?        @map("external_post_url")
  caption        String
  status         PostStatus      @default(PENDING)
  errorMessage   String?         @map("error_message")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  metrics        PostMetric[]

  @@index([runId])
  @@index([channel])
  @@map("posts")
}

model PostMetric {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  clicks     Int      @default(0)
  rawMetrics Json?    @map("raw_metrics")
  recordedAt DateTime @default(now()) @map("recorded_at")

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([recordedAt])
  @@map("post_metrics")
}

model Style {
  id               String   @id @default(uuid())
  name             String
  niche            String
  isActive         Boolean  @default(false) @map("is_active")
  variant          String   @default("A") // "A", "B"
  config           Json     // { palette: {...}, font: {...}, layout: {...}, hook_formula: {...}, pacing: {...} }
  performanceScore Float?   @map("performance_score")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([niche, isActive])
  @@map("styles")
}

model Account {
  id                String        @id @default(uuid())
  platform          String        // "instagram", "youtube", "telegram", "x", "postmill"
  accountIdentifier String        @map("account_identifier") // "@handle" or Channel Name
  tokenExpiresAt    DateTime?     @map("token_expires_at")
  lastCheckedAt     DateTime?     @map("last_checked_at")
  status            AccountStatus @default(HEALTHY)
  lastError         String?       @map("last_error")
  metadata          Json?         // Scopes, capabilities, masked info
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([platform, accountIdentifier])
  @@map("accounts")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

