# ==============================================================================
# SOCIAL ENGINE v3 ENVIRONMENT CONFIGURATION (ZERNIO AS PUBLISHER)
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Application & Infrastructure ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://engine_user:engine_pass@postgres:5432/social_engine?schema=public
REDIS_URL=redis://redis:6379/0
ACTIVE_NICHE=jobs
BASE_PUBLIC_URL=https://yourdomain.com
MEDIA_OUTPUT_DIR=/app/storage/media

# --- Dashboard Security & Cron Auth ---
# CRON_SECRET: Secret token passed in Authorization: Bearer <CRON_SECRET> for cron endpoints
CRON_SECRET=change-this-to-a-very-secure-random-token-min-32-chars
# DASHBOARD_PASSWORD_HASH: bcrypt hash of dashboard admin password
DASHBOARD_PASSWORD_HASH=$2a$12$e868d4d4f8e6c7d8a9b0c1d2e3f4g5h6i7j8k9l0m1n2o3p4q5r6s
# SESSION_SECRET: 32+ character key for signing authentication session cookies
SESSION_SECRET=change-this-to-a-secure-cookie-session-secret-min-32-chars
# Kill switch: "true" pauses all incoming cron triggers immediately
ENGINE_KILL_SWITCH=false

# --- LiteLLM Gateway ---
# The application ONLY communicates with LiteLLM, never direct upstream LLM APIs
LITELLM_BASE_URL=http://litellm:4000
# Virtual key created in LiteLLM for this app (has budget & rate limits)
LITELLM_VIRTUAL_KEY=sk-social-engine-app-virtual-key
# Master key used only inside Docker container to administer LiteLLM
LITELLM_MASTER_KEY=sk-litellm-master-key-admin-only

# Upstream LLM Provider Keys (used ONLY inside LiteLLM container config)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Publisher: Zernio API (Primary) ---
# Active publisher type: "zernio", "postmill", or "direct"
PUBLISHER_TYPE=zernio
ZERNIO_API_URL=https://api.zernio.com
ZERNIO_API_KEY=sk_862d5c4d72517388000c4f9c5a1b406ab49b96fd0bab6de4511145a542456aae
ZERNIO_WEBHOOK_SECRET=
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_TELEGRAM=
ZERNIO_ACCOUNT_INSTAGRAM=
ZERNIO_ACCOUNT_YOUTUBE=
ZERNIO_ACCOUNT_X=

# --- Backup Publisher: Postmill API ---
POSTMILL_API_URL=http://postmill:3000/api
POSTMILL_API_KEY=

# --- Alerts & Monitoring ---
# Private Telegram chat for alerts and daily digests
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_CHAT_ID=
SENTRY_DSN=

# --- Direct Fallback Credentials (Optional if using Zernio) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=

# --- Job Data Sources ---
JOBSPY_SERVICE_URL=http://jobspy-service:8000
DINOMATE_DB_URL=
APIFY_TOKEN=
