# ==============================================================================
# SOCIAL ENGINE (Next.js + MongoDB + Zernio) ENVIRONMENT CONFIGURATION
# Vercel Deployment & Local Setup
# ==============================================================================

# --- Dashboard Password Gate ---
# Website shows only one input box for password matching this value
ADMIN_PASSWORD=MySecurePassword123
# Or optional bcrypt hash:
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=a-very-long-and-secure-random-secret-key-min-32-chars

# --- External Cron Endpoint Authentication ---
# Outside cron (cron-job.org or GitHub Actions) calls:
# GET/POST https://your-domain.vercel.app/api/run?slot=morning&secret=YOUR_CRON_SECRET
CRON_SECRET=my-external-cron-secret-token-min-32-chars

# --- MongoDB Database ---
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/social_engine?retryWrites=true&w=majority
# Alternative alias supported:
# MONGO_URI=

# --- Zernio Publisher API ---
# API Key from your Zernio dashboard (Settings -> API Keys)
ZERNIO_API_KEY=
ZERNIO_PROFILE_NAME=Social Engine Admin

# --- LLM Providers (LiteLLM, Gemini, or Groq) ---
# Direct free-tier API keys (ideal for serverless Vercel):
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional LiteLLM Gateway (if self-hosting LiteLLM proxy):
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_VIRTUAL_KEY=

# --- Optional Alerts ---
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_CHAT_ID=

# --- Operational Switches ---
ENGINE_KILL_SWITCH=false

# --- OpenRouter (Multi-Model Free Provider) ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://dinomate.app
OPENROUTER_SITE_NAME=DinoMate Social Engine

# --- IteraCompute (Free Qwen 27B) ---
ITERACOMPUTE_API_KEY=
ITERACOMPUTE_MODEL=qwen/qwen3.8-27b

# --- MoonMath AI (DeepSeek v4.1 Flash & GLM 5.3 Flash - 1M Context) ---
MOONMATH_API_KEY=
MOONMATH_BASE_URL=https://zro.moonmath.ai/v1
MOONMATH_MODEL=deepseek-v4.1-flash
MOONMATH_FALLBACK_MODEL=glm-5.3-flash

# =====================================================================
# ANIMATED REEL ENGINE (characters + human-like voices)
# =====================================================================
# Delivery mode: skit (comedy, 2-3 characters) | guide (one presenter) |
# voiceover (voice only). Leave empty to auto-rotate for variety.
# Per-run override: /api/run?type=video&mode=skit
VIDEO_MODE=
# hinglish | english | hindi  (always written in Roman script for captions)
CONTENT_LANGUAGE=hinglish
CONTENT_AUDIENCE=Indian college students, freshers and early-career professionals (18-27)
CONTENT_BRAND_CONTEXT=DinoMate (dinomate.app) - verified fresher / entry-level jobs for Indian students
BRAND_HANDLE=dinomate.app
# Set false to render without publishing (for review)
VIDEO_PUBLISH=true

# Optional: real-human stock b-roll for voiceover reels (free key: pexels.com/api)
PEXELS_API_KEY=
# Optional: premium ultra-realistic voices (overrides free Edge neural voices)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Comma-separated ElevenLabs voice IDs
ELEVENLABS_MALE_VOICES=
ELEVENLABS_FEMALE_VOICES=
# Optional: folder of royalty-free background music (auto-ducked under voices)
BGM_DIR=./assets/music

# Runtime paths (defaults usually fine)
PYTHON_BIN=python
FFMPEG_PATH=
REEL_FPS=30
