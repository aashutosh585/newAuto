# ==============================================================================
# SOCIAL ENGINE (Next.js + MongoDB + Zernio) ENVIRONMENT CONFIGURATION
# Vercel Deployment & Local Setup
# ==============================================================================

# --- Dashboard Password Gate ---
# Website shows only one input box for password matching this value
ADMIN_PASSWORD=MySecurePassword123
# Or optional bcrypt hash:
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=a-very-long-and-secure-random-secret-key-min-32-chars

# --- External Cron Endpoint Authentication ---
# Outside cron (cron-job.org or GitHub Actions) calls:
# GET/POST https://your-domain.vercel.app/api/run?slot=morning&secret=YOUR_CRON_SECRET
CRON_SECRET=my-external-cron-secret-token-min-32-chars

# --- MongoDB Database ---
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/social_engine?retryWrites=true&w=majority
# Alternative alias supported:
# MONGO_URI=

# --- Zernio Publisher API ---
# API Key from your Zernio dashboard (Settings -> API Keys)
ZERNIO_API_KEY=
ZERNIO_PROFILE_NAME=Social Engine Admin

# --- LLM Providers (LiteLLM, Gemini, or Groq) ---
# Direct free-tier API keys (ideal for serverless Vercel):
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional LiteLLM Gateway (if self-hosting LiteLLM proxy):
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_VIRTUAL_KEY=

# --- Optional Alerts ---
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_CHAT_ID=

# --- Operational Switches ---
ENGINE_KILL_SWITCH=false
