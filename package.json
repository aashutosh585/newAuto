{
  "name": "social-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Production automated social media publishing engine",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev:web": "pnpm --filter @social-engine/web dev",
    "dev:worker": "pnpm --filter @social-engine/worker dev",
    "db:generate": "pnpm --filter @social-engine/db generate",
    "db:migrate": "pnpm --filter @social-engine/db migrate",
    "db:push": "pnpm --filter @social-engine/db push",
    "lint": "pnpm --recursive run lint",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.32.1"
}
